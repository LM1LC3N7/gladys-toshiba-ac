{
  "name": "gladys-toshiba-ac",
  "version": "0.1.1",
  "private": true,
  "description": "Gladys Assistant external integration for the Toshiba air conditioners of the Toshiba Home AC Control app. Unofficial, not affiliated with Toshiba.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "audit": "npm audit --omit=dev",
    "validate:manifest": "npx --yes github:GladysAssistant/integration-store ."
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.15.0",
    "mqtt": "^5.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "mqtt-packet": "^9.0.2",
    "prettier": "^3.9.9"
  },
  "license": "Apache-2.0"
}
